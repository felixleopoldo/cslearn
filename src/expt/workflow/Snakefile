rule download_intermediates:
    """Download the full intermediate results archive from Zenodo.

    Use this to restore all intermediate files so that snakemake all can
    skip recomputation and proceed directly to aggregation/plotting.
    Not part of rule all.

    Usage:
        snakemake download_intermediates
        snakemake all
    """
    output:
        touch("results/.intermediates_downloaded"),
    container:
        None
    params:
        url=INTERMEDIATES_ARCHIVE_URL,
    shell:
        "curl -L {params.url} | tar xz -C ."
