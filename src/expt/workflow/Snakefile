rule joint_stagedtree_distribution:
    input:
        st=(
            "results/stagedtree_param_est"
            + "/true_cstree=/"
            + pattern_cstree
            + "/true_cstree_params=/"
            + pattern_cstree_params
            + "/data=/"
            + pattern_cstree_data
            + "/alg=/{alg_name}/{alg_parameters}"
            + "/param_est=/{param_est}"
            + "/st.rds"
        ),
        data=rules.cstree_data.output,
    output:
        full_distr=(
            "results/full_distr"
            + "/true_cstree=/"
            + pattern_cstree
            + "/true_cstree_params=/"
            + pattern_cstree_params
            + "/data=/"
            + pattern_cstree_data
            + "/alg=/{alg_name}/{alg_parameters}"
            + "/param_est=/{param_est}"
            + "/distr.csv"
        ),
    wildcard_constraints:
        alg_name="bos|bhc",
    container:
        "docker://bpimages/stagedtrees:2.3.0"
    script:
        "scripts/joint_stagedtree_distr.R"


rule joint_dag_distribution:
    # Estimate a distribution from data
    input:
        input_bn=(
            "results/dag_param_est"
            + "/true_cstree=/{true_cstree}"
            + "/true_cstree_params=/{true_cstree_params}"
            + "/data=/{data}"
            + "/alg=/{alg_name}/{alg}"
            + "/param_est=/{param_est}"
            + "/model.bif"
        ),
    output:
        full_distr=(
            "results/full_distr"
            + "/true_cstree=/{true_cstree}"
            + "/true_cstree_params=/{true_cstree_params}"
            + "/data=/{data}"
            + "/alg=/{alg_name}/{alg}"
            + "/param_est=/{param_est}"
            + "/distr.csv"
        ),
    wildcard_constraints:
        alg_name="grasp|pc",
    script:
        "scripts/joint_dag.py"


rule joint_cstree_distribution:
    # Estimate a distribution from data
    input:
        input_cstree=rules.cslearn_bdeu_parameter_estimation.output,
        data=rules.cstree_data.output,
    output:
        full_distr=(
            "results/full_distr"
            + "/true_cstree=/"
            + pattern_cstree
            + "/true_cstree_params=/"
            + pattern_cstree_params
            + "/data=/"
            + pattern_cstree_data
            + "/alg=/"
            + pattern_cslearn
            + "/param_est=/"
            + pattern_cstree_param_est
            + "/distr.csv"
        ),
    script:
        "scripts/joint_cstree.py"


# Calculate KL divergence between estimated and true distribution
rule kl_div_to_true:
    input:
        true=rules.full_true_cstree_distr.output,
        est=(
            "results/full_distr"
            + "/true_cstree=/"
            + pattern_cstree
            + "/true_cstree_params=/"
            + pattern_cstree_params
            + "/data=/{data}"
            + "/alg=/{alg}"
            + "/param_est=/{param_est}"
            + "/distr.csv"
        ),
    output:
        kl=(
            "results/kl_div"
            + "/true_cstree=/"
            + pattern_cstree
            + "/true_cstree_params=/"
            + pattern_cstree_params
            + "/data=/{data}"
            + "/alg=/{alg}"
            + "/param_est=/{param_est}"
            + "/kl_div.csv"
        ),
    script:
        "scripts/kl_div.py"


# Plot (2a): comparison of performance of parameter MAP estimate versus parameter MLE est with PC used in Phase 1:
#
# KL-divergence on y-axis
# x-axis: number of nodes (p = 5, 7, 10, 15, 20)
# algorithms:
#
#  - PC-estimated DAG (MLE) for n=10000
#
#  - CSlearn with PC (MLE) for n=250
#  - CSlearn with PC (MLE) for n=500
#  - CSlearn with PC (MLE) for n=1000
#  - CSlearn with PC (MLE) for n=10000
#
#  - CSlearn with PC (MAP) for n=250
#  - CSlearn with PC (MAP) for n=500
#  - CSlearn with PC (MAP) for n=1000
#  - CSlearn with PC (MAP) for n=10000
rule kl_plots_2a_csv:
    input:
        cslearn_pc=expand(
            (
                "results/kl_div"
                + "/true_cstree=/"
                + pattern_cstree
                + "/true_cstree_params=/"
                + pattern_cstree_params
                + "/data=/"
                + pattern_cstree_data
                + "/alg=/"
                + pattern_pc_cslearn
                + "/param_est=/"
                + pattern_cstree_param_est
                + "/kl_div.csv"
            ),
            cstree_p=[5, 7, 10, 15, 20],
            cstree_max_cvar=[2],
            cstree_prob_cvar=[1],
            cstree_params_alpha=[1.0],
            cstree_data_n=[250, 500, 1000, 10000],
            alg_name="cslearn",
            cslearn_max_cvar=[2],
            cslearn_prob_cvar=[1],
            cslearn_mcmc_iterations=[5000],
            cslearn_alpha_tot=[1.0],
            cslearn_param_prior=["BDeu"],
            pc_alpha=0.05,
            cstree_param_est_alpha=[
                1
            ],  # this will be ignored for dag_param_est_type="mle"
            cstree_param_est_estimation_type=["map", "mle"],
            seed=seed_range,
        ),
        pc=expand(
            (
                "results/kl_div"
                + "/true_cstree=/"
                + pattern_cstree
                + "/true_cstree_params=/"
                + pattern_cstree_params
                + "/data=/"
                + pattern_cstree_data
                + "/alg=/"
                + pattern_pc
                + "/param_est=/"
                + pattern_dag_param_est
                + "/kl_div.csv"
            ),
            cstree_p=[5, 7, 10, 15, 20],
            cstree_max_cvar=[2],
            cstree_prob_cvar=[1],
            cstree_params_alpha=[1.0],
            cstree_data_n=[10000],
            pc_alpha=0.05,
            alg_name="pc",
            dag_param_est_alpha=[1],
            dag_param_est_estimation_type=["mle"],
            seed=seed_range,
        ),
    output:
        "results/kl_divergence_2a.csv",
    script:
        "scripts/join_csvs.py"


# Plot (2b): comparison of performance of parameter MAP estimate versus parameter MLE est with GrASP used in Phase 1:
# KL-divergence on y-axis
# x-axis: number of nodes (p = 5,7,10,15,20)
# algorithms:
# - GrASP-estimated DAG (MLE) for n=10000
# - CSlearn with GrASP (MAP) for n=250
# - CSlearn with GrASP (MAP) for n=500
# - CSlearn with GrASP (MAP) for n=1000
# - CSlearn with GrASP (MAP) for n=10000
# - CSlearn with GrASP (MLE) for n=250
# - CSlearn with GrASP (MLE) for n=500
# - CSlearn with GrASP (MLE) for n=1000
# - CSlearn with GrASP (MLE) for n=10000
rule kl_plots_2b_csv:
    input:
        cslearn_grasp=expand(
            (
                "results/kl_div"
                + "/true_cstree=/"
                + pattern_cstree
                + "/true_cstree_params=/"
                + pattern_cstree_params
                + "/data=/"
                + pattern_cstree_data
                + "/alg=/"
                + pattern_grasp_cslearn
                + "/param_est=/"
                + pattern_cstree_param_est
                + "/kl_div.csv"
            ),
            cstree_p=[5, 7, 10, 15, 20],
            cstree_max_cvar=[2],
            cstree_prob_cvar=[1],
            cstree_params_alpha=[1.0],
            cstree_data_n=[250, 500, 1000, 10000],
            alg_name="cslearn",
            cslearn_max_cvar=[2],
            cslearn_prob_cvar=[1],
            cslearn_mcmc_iterations=[5000],
            cslearn_alpha_tot=[1.0],
            cslearn_param_prior=["BDeu"],
            cstree_param_est_alpha=[
                1
            ],  # this will be ignored for dag_param_est_type="mle"
            cstree_param_est_estimation_type=[
                "mle",
                "map",
            ],  # might not need this, alpha=0 is mke#["mle", "map"],
            seed=seed_range,
        ),
        grasp=expand(
            (
                "results/kl_div"
                + "/true_cstree=/"
                + pattern_cstree
                + "/true_cstree_params=/"
