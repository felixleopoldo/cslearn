# Run by typing:
# snakemake all
# For dry run type:
# snakemake all -n

seed_range = range(1, 11)

# Precomputed results archive (~5.9 GB). Zenodo: https://doi.org/10.5281/zenodo.21198084
# (concept DOI, resolves to latest version). Version 1.0.1 (record 22118137)
# corrects a time/total_time column swap present in v1.0's CSlearn+PC/GRaSP
# timing intermediates -- see the "fix: correct time/total_time swap in
# stale CSlearn intermediates" commit. This URL is version-specific (Zenodo
# direct file links don't follow the concept DOI to latest), so it must be
# bumped by hand on any future re-upload.
INTERMEDIATES_ARCHIVE_URL = (
    "https://zenodo.org/records/22118137/files/intermediates.tar.gz"
)

# CStree model
pattern_cstree = "cstree/cstree_p={cstree_p}/cstree_max_cvar={cstree_max_cvar}/cstree_prob_cvar={cstree_prob_cvar}/seed={seed}"
pattern_cstree_params = (
    "true_cstree_params/cstree_params_alpha={cstree_params_alpha}/seed={seed}"
)
pattern_cstree_data = "data/cstree_data_n={cstree_data_n}/seed={seed}"

# Structure learning
pattern_cslearn = (
    "cslearn/alg_name={alg_name}/cslearn_poss_cvars={cslearn_poss_cvars}/cslearn_mcmc_iterations={cslearn_mcmc_iterations}/"
    "cslearn_alpha_tot={cslearn_alpha_tot}/cslearn_param_prior={cslearn_param_prior}/"
    "cslearn_max_cvar={cslearn_max_cvar}/cslearn_prob_cvar={cslearn_prob_cvar}/seed={seed}"
)
pattern_grasp = "grasp/alg_name={alg_name}/seed={seed}"
pattern_pc = "pc/alg_name={alg_name}/pc_alpha={pc_alpha}/seed={seed}"
pattern_bos = "bos/alg_name={alg_name}/seed={seed}"
pattern_bhc = "bhc/alg_name={alg_name}/bhc_start_alg={bhc_start_alg}/seed={seed}"

# Structure learning with imposed start algorithm pattern
pattern_grasp_bhc = (
    "bhc/alg_name={alg_name}/bhc_start_alg=" + pattern_grasp + "/seed={seed}"
)
pattern_pc_bhc = "bhc/alg_name={alg_name}/bhc_start_alg=" + pattern_pc + "/seed={seed}"

# With imposed poss_cvars
pattern_pc_cslearn = (
    "cslearn/alg_name={alg_name}/cslearn_poss_cvars="
    + pattern_pc
    + "/cslearn_mcmc_iterations={cslearn_mcmc_iterations}/"
    "cslearn_alpha_tot={cslearn_alpha_tot}/cslearn_param_prior={cslearn_param_prior}/"
    "cslearn_max_cvar={cslearn_max_cvar}/cslearn_prob_cvar={cslearn_prob_cvar}/seed={seed}"
)
pattern_grasp_cslearn = (
    "cslearn/alg_name={alg_name}/cslearn_poss_cvars="
    + pattern_grasp
    + "/cslearn_mcmc_iterations={cslearn_mcmc_iterations}/"
    "cslearn_alpha_tot={cslearn_alpha_tot}/cslearn_param_prior={cslearn_param_prior}/"
    "cslearn_max_cvar={cslearn_max_cvar}/cslearn_prob_cvar={cslearn_prob_cvar}/seed={seed}"
)

# Parameter estimation
pattern_dag_param_est = "dag_param_est/dag_param_est_estimation_type={dag_param_est_estimation_type}/dag_param_est_alpha={dag_param_est_alpha}/seed={seed}"  # type is bdeu or mle
pattern_cstree_param_est = "cstree_param_est/cstree_param_est_estimation_type={cstree_param_est_estimation_type}/cstree_param_est_alpha={cstree_param_est_alpha}/seed={seed}"  # type is bdeu or mle
pattern_st_param_est = "st_param_est/st_param_est_estimation_type={st_param_est_estimation_type}/st_param_est_alpha={st_param_est_alpha}/seed={seed}"  # type is bdeu or mle

# Evaluation
pattern_kl_div = "kl_div"


container: "oras://docker.io/causaldev/cslearn-expt:1.3.3-amd64"


def input_cvars(wildcards):
    """
    Input for the poss_cvars parameter of the cslearn algorithm
    """

    if wildcards.cslearn_poss_cvars == "None":
        return []
    else:
        # the poss_cvars will be the pattern string of a DAG estimation algorithm
        return (
            "results/estimate"
            + "/true_cstree=/"
            + pattern_cstree
            + "/true_cstree_params=/"
            + pattern_cstree_params
            + "/data=/"
            + pattern_cstree_data
            + "/alg=/"
            + wildcards.cslearn_poss_cvars
            + "/poss_cvars.json"
        )


def input_alg(wildcards):

    if wildcards.bhc_start_alg == "None":
        return []
    else:
        # the poss_cvars will be the pattern string of a DAG estimation algorithm
        return (
            "results/estimate"
            + "/true_cstree=/"
            + pattern_cstree
            + "/true_cstree_params=/"
            + pattern_cstree_params
            + "/data=/"
            + pattern_cstree_data
            + "/alg=/"
            + wildcards.bhc_start_alg
            + "/dag.csv"
        )  # dag.csv


def input_time_bhc(wildcards):

    if wildcards.bhc_start_alg == "None":
        return []
    else:
        # the poss_cvars will be the pattern string of a DAG estimation algorithm
        return (
            "results/time"
            + "/true_cstree=/"
            + pattern_cstree
            + "/true_cstree_params=/"
            + pattern_cstree_params
            + "/data=/"
            + pattern_cstree_data
            + "/alg=/"
            + wildcards.bhc_start_alg
            + "/time.csv"
        )


def input_time_cslearn(wildcards):

    if wildcards.cslearn_poss_cvars == "None":
        return []
    else:
        # the poss_cvars will be the pattern string of a DAG estimation algorithm
        return (
            "results/time"
            + "/true_cstree=/"
            + pattern_cstree
            + "/true_cstree_params=/"
            + pattern_cstree_params
            + "/data=/"
            + pattern_cstree_data
            + "/alg=/"
            + wildcards.cslearn_poss_cvars
            + "/time.csv"
        )


