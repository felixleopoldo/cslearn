        "results/sensitivity.pdf",
        "results/runtime_phases.pdf",


# Reads a DAG (adjacency matrix) and returns a list of possible cvars
# as a JSON file.
rule dag_to_poss_cvar:
    input:
        "{whatever}/cpdag.csv",
    output:
        "{whatever}/poss_cvars.json",
    script:
        "scripts/dag_to_poss_cvar.py"


rule cstree:
    output:
        "results/true_cstree/" + pattern_cstree + "/cstree.csv",
    script:
        "scripts/generate_cstree.py"


rule cstree_params:
    input:
        cstree=rules.cstree.output,
    output:
        (
            "results/true_cstree_params/"
            + pattern_cstree_params
            + "/true_cstree/"
            + pattern_cstree
            + "/cstree.csv"
        ),
    script:
        "scripts/generate_cstree_params.py"


