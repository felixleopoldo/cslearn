# Figure 5 (SHD): all 4 panels assembled in one Python-generated 1x4 grid
# (square_grid/add_shared_legend, see palette.py) instead of 4 separately
# generated panel PDFs + a separate legend PDF stitched together in LaTeX --
# that split-file design was what made an earlier "4 panels in one row"
# attempt illegible (each panel authored at 2.9in but LaTeX-displayed at a
# narrower 0.24\textwidth, shrinking the embedded fonts with it) and, this
# round, produced cropped x-axis labels (each narrow panel had to fit its
# own full label set with no shared margin). One script, one PDF, included
# in the manuscript at native size (no \includegraphics width= -- see
# CLAUDE.md's "authored width must equal display width" note).
rule shd_plot:
    input:
        a="results/shd_a.csv",
        b="results/shd_b.csv",
        c="results/shd_c.csv",
        scale="results/shd_scale.csv",
    output:
        "results/shd.pdf",
    script:
        "scripts/plot_shd.py"


# Sensitivity analysis: β-misspecification.
#
# Shows SHD (LDAG) when CSlearn+GRaSP (β_est=2) is applied to data from
# CStrees with β_true ∈ {1, 2, 3}:
#   β_true=1: over-specified (CSlearn's hypothesis class is richer than needed)
#   β_true=2: correctly specified
#   β_true=3: under-specified (CSlearn's hypothesis class cannot capture all
#             context structures present in the data)
#
# p=5..15, n=250/1000, prob_cvar=0.5.
rule sensitivity_shd_csv:
    input:
        correct=expand(
            (
                "results/shd"
                + "/true_cstree=/"
                + pattern_cstree
                + "/true_cstree_params=/"
                + pattern_cstree_params
                + "/data=/"
                + pattern_cstree_data
                + "/alg=/"
                + pattern_grasp_cslearn
                + "/shd.csv"
            ),
            cstree_p=[5, 7, 10, 15],
            cstree_max_cvar=[2],
            cstree_prob_cvar=[0.5],
            cstree_params_alpha=[1.0],
            cstree_data_n=[250, 1000],
            alg_name="cslearn",
            cslearn_max_cvar=[2],
            cslearn_prob_cvar=[1],
            cslearn_mcmc_iterations=[5000],
            cslearn_alpha_tot=[1.0],
            cslearn_param_prior=["BDeu"],
            seed=seed_range,
        ),
        under=expand(
            (
                "results/shd"
                + "/true_cstree=/"
                + pattern_cstree
                + "/true_cstree_params=/"
                + pattern_cstree_params
                + "/data=/"
                + pattern_cstree_data
                + "/alg=/"
                + pattern_grasp_cslearn
                + "/shd.csv"
            ),
            cstree_p=[5, 7, 10, 15],
            cstree_max_cvar=[3],
            cstree_prob_cvar=[0.5],
            cstree_params_alpha=[1.0],
            cstree_data_n=[250, 1000],
            alg_name="cslearn",
            cslearn_max_cvar=[2],
            cslearn_prob_cvar=[1],
            cslearn_mcmc_iterations=[5000],
            cslearn_alpha_tot=[1.0],
            cslearn_param_prior=["BDeu"],
            seed=seed_range,
        ),
        over=expand(
            (
                "results/shd"
                + "/true_cstree=/"
                + pattern_cstree
                + "/true_cstree_params=/"
                + pattern_cstree_params
                + "/data=/"
                + pattern_cstree_data
                + "/alg=/"
                + pattern_grasp_cslearn
                + "/shd.csv"
            ),
            cstree_p=[5, 7, 10, 15],
            cstree_max_cvar=[1],
            cstree_prob_cvar=[0.5],
            cstree_params_alpha=[1.0],
            cstree_data_n=[250, 1000],
            alg_name="cslearn",
            cslearn_max_cvar=[2],
            cslearn_prob_cvar=[1],
            cslearn_mcmc_iterations=[5000],
            cslearn_alpha_tot=[1.0],
            cslearn_param_prior=["BDeu"],
            seed=seed_range,
        ),
    output:
        "results/sensitivity_shd.csv",
    script:
        "scripts/join_sensitivity_shd.py"


