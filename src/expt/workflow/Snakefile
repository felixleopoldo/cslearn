# The parameters for the dag algorithms should be learned in separate rule,
# as this is done in R for both grasp and pc.
rule dag_bdeu_parameter_estimation:
    input:
        dag=(
            "results/estimate"
            + "/true_cstree=/"
            + pattern_cstree
            + "/true_cstree_params=/"
            + pattern_cstree_params
            + "/data=/"
            + pattern_cstree_data
            + "/alg=/{alg}"
            + "/dag.csv"
        ),
        data=rules.cstree_data.output,
    output:
        dag_param_est=(
            "results/dag_param_est"
            + "/true_cstree=/"
            + pattern_cstree
            + "/true_cstree_params=/"
            + pattern_cstree_params
            + "/data=/"
            + pattern_cstree_data
            + "/alg=/{alg}"
            + "/param_est=/"
            + pattern_dag_param_est
            + "/model.bif"
        ),
    script:
        "scripts/dag_bdeu_parameter_estimation.py"


