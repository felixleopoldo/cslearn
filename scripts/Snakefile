"""
Plot (2c): Comparison of CSlearn with other methods:

KL-divergence on y-axis
x-axis: number of nodes (p = 5,7,10,15,20)
algorithms:
    - GrASP-estimated DAG (MLE) for n = 10000
    - CSlearn with GrASP for n = 1000
    - CSlearn with GrASP for n = 10000
    - bos (stagedtrees) with n = 1000
    - GrASP + bhc (stagedtrees) with n = 1000
    - GrASP + bhc (stagedtrees) with n = 10000
* notes:
    - best order search is only done for p = 5,7,10
    - GrASP + bhc is done for p = 5,7,10,15,20
    - bhc = backwards hill climbing
    - bos = best order search
"""
rule: kl_plots_2c_csv:
    input: 
        grasp = expand(("kl_div" +                    
            "/true_cstree=/" + pattern_cstree +
            "/true_cstree_params=/" + pattern_cstree_params +
            "/data=/" + pattern_cstree_data + 
            "/alg=/" + pattern_grasp +
            "/param_est=/" + pattern_dag_param_est +
            "/kl_div.csv"),
                cstree_p=[5,7,10,15],                
                cstree_max_cvar=[2],
                cstree_prob_cvar=[1],
                cstree_params_alpha=[0.05],
                data_n=[10000],
                dag_param_est_alpha=[0.05],
                dag_param_est_type=["mle"],
                seed=range(1, 11)),
        cslearn_grasp = expand(("kl_div" +
                                "/true_cstree=/" + pattern_cstree +
                                "/true_cstree_params=/" + pattern_cstree_params +
                                "/data=/" + pattern_cstree_data + 
                                "/alg=/" + pattern_grasp_cslearn +
                                "/param_est=/" + pattern_dag_param_est +
                                "/kl_div.csv"),
                        cstree_p=[5,7,10,15],                
                        cstree_max_cvar=[2],
                        cstree_prob_cvar=[1],
                        cstree_params_alpha=[0.05],
                        data_n=[1000, 10000],
                        cslearn_max_cvar=[2],
                        cslearn_prob_cvar=[1],                
                        dag_param_est_alpha=[0.05], # this will be ignored for dag_param_est_type="mle"
                        dag_param_est_type=["mle"],
                        seed=range(1, 11)),

        bos = expand(("kl_div" +                   
                    "/true_cstree=/" + pattern_cstree +
                    "/true_cstree_params=/" + pattern_cstree_params +
                    "/data=/" + pattern_cstree_data + 
                    "/alg=/" + pattern_bos +
                    "/param_est=/" + pattern_dag_param_est +
                    "/kl_div.csv"),
                cstree_p=[5,7,10,15],                
                cstree_max_cvar=[2],
                cstree_prob_cvar=[1],
                cstree_params_alpha=[0.05],
                data_n=[1000],
                dag_param_est_alpha=[0.05],
                dag_param_est_type=["mle"],
                seed=range(1, 11)),

        grasp_bhc = expand(("kl_div" +                    
                            "/true_cstree=/" + pattern_cstree +
                            "/true_cstree_params=/" + pattern_cstree_params +
                            "/data=/" + pattern_cstree_data + 
                            "/alg=/" + pattern_grasp_bhc +
                            "/param_est=/" + pattern_dag_param_est +
                            "/kl_div.csv"),
                cstree_p=[5,7,10,15,20],
                cstree_max_cvar=[2],
                cstree_prob_cvar=[1],
                cstree_params_alpha=[0.05],
                data_n=[1000, 10000],
                dag_param_est_alpha=[0.05],
                dag_param_est_type=["mle"],
                seed=range(1, 11)), 
                
    output: 
        "results/kl_divergence_2c.csv"
    script: 
        "rule_scripts/join_kl.py" # this script will join the csv files

