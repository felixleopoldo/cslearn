rule joint_stagedtree_distribution:
    input: # this coud be either bhc or bos
        input_st = ("stagedtree_param_est" +
                    "/true_cstree=/{true_cstree}" +
                    "/true_cstree_params=/{true_cstree_params}" +
                    "/data=/{data}" +
                    "/alg=/{alg_name}/{alg_parameters}" +
                    "/param_est=/{param_est}" +
                    "/st.rds")
    output:
        full_distr=("full_distr" +
                    "/true_cstree=/{true_cstree}" +
                    "/true_cstree_params=/{true_cstree_params}" +
                    "/data=/{data}" +
                    "/alg=/{alg_name}/{alg_parameters}" +
                    "/param_est=/{param_est}" +
                    "/distr.csv") # this needs to be matched better
    wildcard_constraints:
        alg_name = "bos|bhc"
    script:
        "snake_scripts/joint_stagedtree_distr.R"

