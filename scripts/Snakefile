rule bos:
    # Use BOS to learn CPDAG from which poss_cvars and a Markov equiv DAG are selected
    input:
        data=rules.cstree_data.output
    output:
        st=("results/estimate" +
            "/true_cstree=/" + pattern_cstree +
            "/true_cstree_params=/" + pattern_cstree_params +
            "/data=/" + pattern_cstree_data +
            "/alg=/" + pattern_bos +
            "/structure.rds"),
        time=("results/time" +
              "/true_cstree=/" + pattern_cstree +
              "/true_cstree_params=/" + pattern_cstree_params +
              "/data=/" + pattern_cstree_data +
              "/alg=/" + pattern_bos +
              "/time.csv")
    container: "docker://bpimages/stagedtrees:2.3.0"
    script:
        "snake_scripts/estimate_bos.R"

rule bhc:
    # Use BHC to learn CPDAG from which poss_cvars and a Markov equiv DAG are selected
    input:
        data=rules.cstree_data.output,
        input_alg_dag=input_alg,
        input_alg_time=input_time_bhc

    output:
        structure=("results/estimate" +
                   "/true_cstree=/" + pattern_cstree +
                   "/true_cstree_params=/" + pattern_cstree_params +
                   "/data=/" + pattern_cstree_data +
                   "/alg=/" + pattern_bhc +
                   "/structure.rds"), # This might not be a csv file
        time=("results/time" +
              "/true_cstree=/" + pattern_cstree +
              "/true_cstree_params=/" + pattern_cstree_params +
              "/data=/" + pattern_cstree_data +
              "/alg=/" + pattern_bhc +
              "/time.csv"),
    container: "docker://bpimages/stagedtrees:2.3.0"
    script:
        "snake_scripts/estimate_bhc.R"

rule cslearn:                   # tested
    # cstree structure learning
    input:
        data=rules.cstree_data.output,
        poss_cvars=input_cvars, # will be empty if poss_cvars is None
        input_time=input_time_cslearn
    output:
        cstree = ("results/estimate" +
                  "/true_cstree=/" + pattern_cstree +
                  "/true_cstree_params=/" + pattern_cstree_params +
                  "/data=/" + pattern_cstree_data +
                  "/alg=/" + pattern_cslearn +
                  "/structure.csv"),
        #  add time and total time (including poss_csvars time)
        time = ("results/time" +
                "/true_cstree=/" + pattern_cstree +
                "/true_cstree_params=/" + pattern_cstree_params +
                "/data=/" + pattern_cstree_data +
                "/alg=/" + pattern_cslearn +
                "/time.csv"),
    script:
        "snake_scripts/estimate_cstree.py"

