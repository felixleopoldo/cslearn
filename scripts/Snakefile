# Reads a DAG (adjacency matrix) and returns a list of possible cvars
# as a JSON file.
rule dag_to_poss_cvar:          # tested
    input:
        "{whatever}/cpdag.csv" # dag.csv
    output:
        "{whatever}/poss_cvars.json"
    script:
        "snake_scripts/dag_to_poss_cvar.py"

