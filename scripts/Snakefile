# Maybe we could prefix each pattern variable, e.g. pc_alpha
pattern_cstree = "cstrees/p={p}/max_cvar={max_cvar}/prob_cvar={prob_cvar}/seed={seed}"
pattern_cstree_params = "true_cstree_params/alpha_tot/{alpha_tot}/seed={seed}"
pattern_cstree_data = "data/n={n}/seed={seed}"
pattern_cslearn = "cslearn/p={p}/input_dag={input_dag}/max_cvar={max_cvar}/prob_cvar={prob_cvar}/seed={seed}"
pattern_grasp = "grasp/seed={seed}"
pattern_pc = "pc/alpha={alpha}/seed={seed}"
pattern_dag_param_est = "dag_param_est/estimation_type={estimation_type}/alpha={alpha}/seed={seed}" # type is bdeu or mle
pattern_cstree_param_est = "cstree_param_est/estimation_type={estimation_type}/alpha={alpha}/seed={seed}" # type is bdeu or mle

rule all:
    input:
        "results/kl_divergence_2a.png", 
        "results/kl_divergence_2b.png", 
        "results/kl_divergence_2c.png"

rule generate_cstree:           # tested
    # Calculate KL divergence between two distribution
    output:
        "true_cstree/"+ pattern_cstree + "/cstree.csv"
    script:
        "snake_scripts/generate_cstree.py"

rule generate_cstree_params:     # untested
    input:
        cstree="true_cstree/"+ pattern_cstree + "/cstree.csv"
    output:
        "true_cstree_params/"+pattern_cstree_params+"/true_cstree/"+ pattern_cstree + "/cstree.csv"
    script:
        "snake_scripts/generate_cstree_params.py"

# this gives the whole cstree, but we split it into separate rules for consistency
rule simulate_cstree_data:             # tested
    # Simulate data from a distribution
    input:
        cstree="true_cstree_params/"+pattern_cstree_params+"/true_cstree/"+ pattern_cstree + "/cstree.csv" 
    output:
        ("data"+
         "/true_cstree=/"+ pattern_cstree + 
         "/true_cstree_params=/" + pattern_cstree_params +
         "/data=/"+pattern_cstree_data + "/data.csv")
    script:
        "snake_scripts/simulate_data.py"

rule estimate_cstree:           # untested
    # Estimate a distribution from data
    input:
        data=rules.simulate_cstree_data.output,
        #poss_cvars="some dag" if not "{input_dag}" is None else []
    output:
        cstree = ("estimate" +
                  "/alg=/" + pattern_cslearn +                   
                  "/true_cstree=/" + pattern_cstree +
                  "/true_cstree_params=/" + pattern_cstree_params +
                  "/data=/" + pattern_cstree_data + 
                  "/structure.csv")
    script:
        "snake_scripts/estimate_cstree.py"

rule estimate_grasp:            # tested
    # Use GRaSP to learn CPDAG from which poss_cvars and a Markov equiv DAG are selected
    input:
        rules.simulate_data.output
    output:
        grasp_dag=("estimate" +
                   "/alg=/" + pattern_grasp + 
                   "/true_cstree=/" + pattern_cstree +
                   "/true_cstree_params=/" + pattern_cstree_params +
                   "/data=/" + pattern_cstree_data + 
                   "/structure.csv"), #
        grasp_cvars=("estimate" +
                     "/alg=/" + pattern_grasp + 
                     "/true_cstree=/" + pattern_cstree +
                     "/true_cstree_params=/" + pattern_cstree_params +
                     "/data=/" + pattern_cstree_data + 
                     "/poss_cvars.json")
    script:
        "snake_scripts/estimate_grasp.py"

rule estimate_pc:               # tested
    # Use PC to learn CPDAG from which poss_cvars and a Markov equiv DAG are selected
    input:
        rules.simulate_data.output
    output:
        pc_dag=("estimate" +
                "/alg=/" + pattern_pc + 
                "/true_cstree=/" + pattern_cstree +
                "/true_cstree_params=/" + pattern_cstree_params +
                "/data=/" + pattern_cstree_data + 
                "/structure.csv"),
        pc_cvars=("estimate" +
                  "/alg=/" + pattern_pc + 
                  "/true_cstree=/" + pattern_cstree +
                  "/true_cstree_params=/" + pattern_cstree_params +
                  "/data=/" + pattern_cstree_data + 
                  "/poss_cvars.json")
    script:
        "snake_scripts/estimate_pc.py"

# The parameters fro the dag algorithms should be learned in separate rule,
# as this is done in R for both grasp and pc.
rule dag_bdeu_parameter_estimation:
    input:
        dag = ("estimate" +
                "/alg=/{alg}" + 
                "/true_cstree=/{true_cstree}" +   
                "/true_cstree_params=/{true_cstree_params}"             
                "/data=/{data}" + 
                "/dag_est/{dag_est}" +
                "/dag.csv")
    output:
        dag_param_est=("dag_param_est" +
                       "/alg=/{alg}" + 
                       "/true_cstree=/{true_cstree}" +
                       "/true_cstree_params=/{true_cstree_params}" +
                       "/data=/{data}" + 
                       "/dag_est/{dag_est}" +
                       "/param_est=/"+pattern_dag_param_est+"/params.csv")

# CS-BDeu
rule cstree_bdeu_parameter_estimation:
    input:
        cstree = rules.estimate_cstree.output,
        data = rules.simulate_data.output
    output:
        cstree_param_est=("cstree_param_est" +
                          "/alg=/{alg}" + 
                          "/true_cstree=/{true_cstree}" +
                          "/true_cstree_params=/{true_cstree_params}" +
                          "/data=/{data}" + 
                          "/param_est=/"+pattern_cstree_param_est+"/cstree.csv")
    script:
        "scripts/cstree_bdeu_parameter_estimation.R"


rule joint_dag_distribution:    # untested
    # Estimate a distribution from data
    input:
        input_dag = ("estimate" +
                    "/alg=/{alg}" + 
                    "/true_cstree=/{true_cstree}" +
                    "/true_cstree_params=/{true_cstree_params}" +
                    "/data=/{data}" + 
                    "/structure.csv")
    output:
        full_distr=("full_distr" +
                    "/alg=/{alg}" + 
                    "/true_cstree=/{true_cstree}" +
                    "/true_cstree_params=/{true_cstree_params}" +
                    "/data=/{data}" + 
                    "/distr.csv")
    script:
        "snake_scripts/joint_dag.py"

rule joint_cstree_distrubtion:  # untested
    # Estimate a distribution from data
    input:
        cstree = rules.estimate_cstree.output,
        data = rules.simulate_data.output
    output:
        joint_cstree="sim_results/distr/est/p={p}_n={n}_seed={seed}/"
                     "joint_cstree/p={p}/max_cvar={max_cvar}/prob_cvar={prob_cvar}/seed={seed}/cstree_map.csv"
    script:
        "scripts/joint_cstree.py"

rule kl_div_to_true:
    # Calculate KL divergence between estimated and true distribution
    input: 
        true="sim_results/distr/true/p={p}_n={n}_seed={seed}/.csv",
        est="sim_results/distr/est/p={p}_n={n}_seed={seed}/joint_cstree/p={p}/max_cvar={max_cvar}/prob_cvar={prob_cvar}/seed={seed}/.csv"
    output: 
        "sim_results/kl_div/p={p}_n={n}_seed={seed}/joint_cstree/p={p}/max_cvar={max_cvar}/prob_cvar={prob_cvar}/seed={seed}/.csv"
    script: 
        "scripts/kl_div.py"

""" Plot (2a): comparison of performance of parameter MAP estimate versus parameter MLE est with PC used in Phase 1:

KL-divergence on y-axis
x-axis: number of nodes (p = 5,7,10,15,20)
algorithms:

 - PC-estimated DAG (MLE) for n=10000

 - CSlearn with PC (MLE) for n=250
 - CSlearn with PC (MLE) for n=500
 - CSlearn with PC (MLE) for n=1000
 - CSlearn with PC (MLE) for n=10000

 - CSlearn with PC (MAP) for n=250
 - CSlearn with PC (MAP) for n=500
 - CSlearn with PC (MAP) for n=1000
 - CSlearn with PC (MAP) for n=10000
"""
rule: kl_plots_2a
    input: expand("sim_results/kl_div/p={p}_n={n}_seed={seed}/joint_cstree/p={p}/max_cvar={max_cvar}/prob_cvar={prob_cvar}/seed={seed}/.csv",
                     p=range(1, 11),
                     n=range(100, 1001, 100),
                     max_cvar=range(1, 11),
                     prob_cvar=range(1, 11),
                     seed=range(1, 11)) 
                
    output: "results/kl_divergence_2a.png"
    shell: "Rscript scripts/kl_divergence.R"


"""
Plot (2b): comparison of performance of parameter MAP estimate versus parameter MLE est with GrASP used in Phase 1:
KL-divergence on y-axis
x-axis: number of nodes (p = 5,7,10,15,20)
algorithms:
- GrASP-estimated DAG (MLE) for n=10000
- CSlearn with GrASP (MAP) for n=250
- CSlearn with GrASP (MAP) for n=500
- CSlearn with GrASP (MAP) for n=1000
- CSlearn with GrASP (MAP) for n=10000
- CSlearn with GrASP (MLE) for n=250
- CSlearn with GrASP (MLE) for n=500
- CSlearn with GrASP (MLE) for n=1000
- CSlearn with GrASP (MLE) for n=10000
""""
rule: kl_plots_2b
    input: expand("sim_results/kl_div/p={p}_n={n}_seed={seed}/joint_dag/p={p}/max_cvar={max_cvar}/prob_cvar={prob_cvar}/seed={seed}/.csv",
                     p=range(1, 11),
                     n=range(100, 1001, 100),
                     max_cvar=range(1, 11),
                     prob_cvar=range(1, 11),
                     seed=range(1, 11)) 
                
    output: "results/kl_divergence_2b.png"
    shell: "Rscript scripts/kl_divergence.R"

"""
Plot (2c): Comparison of CSlearn with other methods:

KL-divergence on y-axis
x-axis: number of nodes (p = 5,7,10,15,20)
algorithms:
    - GrASP-estimated DAG (MLE) for n = 10000
    - CSlearn with GrASP for n = 1000
    - CSlearn with GrASP for n = 10000
    - bos (stagedtrees) with n = 1000
    - GrASP + bhc (stagedtrees) with n = 1000
    - GrASP + bhc (stagedtrees) with n = 10000
* notes:
    - best order search is only done for p = 5,7,10
    - GrASP + bhc is done for p = 5,7,10,15,20
    - bhc = backwards hill climbing
    - bos = best order search
"""
rule: kl_plots_2c:
    input: expand("sim_results/kl_div/p={p}_n={n}_seed={seed}/grasp/p={p}/max_cvar={max_cvar}/prob_cvar={prob_cvar}/seed={seed}/.csv",
                     p=range(1, 11),
                     n=range(100, 1001, 100),
                     max_cvar=range(1, 11),
                     prob_cvar=range(1, 11),
                     seed=range(1, 11)) 
                
    output: "results/kl_divergence_2c.png"
    shell: "Rscript scripts/kl_divergence.R"