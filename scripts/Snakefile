# Maybe we could prefix each pattern variable, e.g. pc_alpha

# cstree model
pattern_cstree = "cstree/cstree_p={cstree_p}/cstree_max_cvar={cstree_max_cvar}/cstree_prob_cvar={cstree_prob_cvar}/seed={seed}"
pattern_cstree_params = "true_cstree_params/cstree_params_alpha={cstree_params_alpha}/seed={seed}"
pattern_cstree_data = "data/cstree_data_n={cstree_data_n}/seed={seed}"

# Structure learning
pattern_cslearn = "cslearn/cslearn_poss_cvars={cslearn_poss_cvars}/cslearn_max_cvar={cslearn_max_cvar}/cslearn_prob_cvar={cslearn_prob_cvar}/seed={seed}"
pattern_grasp = "grasp/seed={seed}"
pattern_pc = "pc/pc_alpha={pc_alpha}/seed={seed}"
pattern_bos = "bos/seed={seed}"
pattern_bhc = "bhc/bhc_start_alg={bhc_start_alg}/seed={seed}"

# With imposed start algorithm
pattern_grasp_bhc = "bhc/bhc_start_alg="+ pattern_grasp +"/seed={seed}"
pattern_pc_bhc = "bhc/bhc_start_alg="+pattern_pc +"/seed={seed}"

# with imposed poss_cvars
pattern_pc_cslearn = "cslearn/cslearn_poss_cvars="+pattern_pc+"/cslearn_max_cvar={cslearn_max_cvar}/cslearn_prob_cvar={cslearn_prob_cvar}/seed={seed}"
pattern_grasp_cslearn = "cslearn/cslearn_poss_cvars="+pattern_grasp+"/cslearn_max_cvar={cslearn_max_cvar}/cslearn_prob_cvar={cslearn_prob_cvar}/seed={seed}"

# parameter
pattern_dag_param_est = "dag_param_est/dag_param_est_estimation_type={dag_param_est_estimation_type}/dag_param_est_alpha={dag_param_est_alpha}/seed={seed}" # type is bdeu or mle
pattern_cstree_param_est = "cstree_param_est/cstree_param_est_estimation_type={cstree_param_est_estimation_type}/cstree_param_est_alpha={cstree_param_est_alpha}/seed={seed}" # type is bdeu or mle
pattern_st_param_est = "st_param_est/st_param_est_estimation_type={st_param_est_estimation_type}/st_param_est_alpha={st_param_est_alpha}/seed={seed}" # type is bdeu or mle

# evaluation
pattern_kl_div = "kl_div"


def input_cvars(wildcards):
    """
    Input for the poss_cvars parameter of the cslearn algorithm
    """

    if wildcards.cslearn_poss_cvars == "None":
        return []
    else:
        # the poss_cvars will be the pattern string of a DAG estimation algorithm
        return ("estimate" +                
                "/true_cstree=/" + pattern_cstree +
                "/true_cstree_params=/" + pattern_cstree_params +
                "/data=/" + pattern_cstree_data +
                "/alg=/" + wildcards.cslearn_poss_cvars +
                "/poss_cvars.json")

def input_alg(wildcards):

    if wildcards.bhc_start_alg == "None":
        return []
    else:
        # the poss_cvars will be the pattern string of a DAG estimation algorithm
        return ("estimate" +                
                "/true_cstree=/" + pattern_cstree +
                "/true_cstree_params=/" + pattern_cstree_params +
                "/data=/" + pattern_cstree_data +
                "/alg=/" + wildcards.bhc_start_alg +
                "/structure.csv")

rule all:
    input:
        "results/kl_divergence_2a.png",
        "results/kl_divergence_2b.png",
        "results/kl_divergence_2c.png"

rule cstree:           # tested
    # Calculate KL divergence between two distribution
    output:
        "true_cstree/"+ pattern_cstree + "/cstree.csv"
    script:
        "snake_scripts/generate_cstree.py"

rule cstree_params:     # untested
    input:
        cstree=rules.cstree.output
    output:
        ("true_cstree_params/"+pattern_cstree_params+
         "/true_cstree/"+ pattern_cstree + "/cstree.csv")
    script:
        "snake_scripts/generate_cstree_params.py"

rule full_true_cstree_distr:     # untested
    input:
        cstree=rules.cstree.output,
        cstree_params=rules.cstree_params.output
    output:
        ("full_true_distr/"+
         pattern_cstree+"/true_cstree_params/"+
         pattern_cstree_params+"/distr.csv")
    script:
        "snake_scripts/full_true_cstree_distr.py"

# this gives the whole cstree, but we split it into separate rules for consistency
rule cstree_data:             # tested
    # Simulate data from a distribution
    input:
        cstree=rules.cstree_params.output
    output:
        ("data"+
         "/true_cstree=/"+ pattern_cstree +
         "/true_cstree_params=/" + pattern_cstree_params +
         "/data=/"+pattern_cstree_data + "/data.csv")
    script:
        "snake_scripts/simulate_data.py"


rule bos:
    # Use BOS to learn CPDAG from which poss_cvars and a Markov equiv DAG are selected
    input:
        rules.cstree_data.output
    output:
        bos_dag=("estimate" +
                 "/true_cstree=/" + pattern_cstree +
                 "/true_cstree_params=/" + pattern_cstree_params +
                 "/data=/" + pattern_cstree_data +
                 "/alg=/" + pattern_bos +
                 "/structure.csv")
    script:
        "snake_scripts/estimate_bos.R"

rule bhc:
    # Use BHC to learn CPDAG from which poss_cvars and a Markov equiv DAG are selected
    input:
        rules.cstree_data.output,
        input_alg=input_alg
    output:
        ("estimate" +
        "/true_cstree=/" + pattern_cstree +
        "/true_cstree_params=/" + pattern_cstree_params +
        "/data=/" + pattern_cstree_data +
        "/alg=/" + pattern_bhc +
        "/structure.csv") # This might not be a csv file
    script:
        "snake_scripts/estimate_bhc.R"

rule cslearn:           # untested
    # Estimate a distribution from data
    input:
        data=rules.cstree_data.output,
        poss_cvars=input_cvars # will be empty if poss_cvars is None
    output:
        cstree = ("estimate" +
                  "/true_cstree=/" + pattern_cstree +
                  "/true_cstree_params=/" + pattern_cstree_params +
                  "/data=/" + pattern_cstree_data +
                  "/alg=/" + pattern_cslearn +
                  "/structure.csv")
    script:
        "snake_scripts/estimate_cstree.py"

rule grasp:            # tested
    # Use GRaSP to learn CPDAG from which poss_cvars and a Markov equiv DAG are selected
    input:
        rules.cstree_data.output
    output:
        dag=("estimate" +
                   "/true_cstree=/" + pattern_cstree +
                   "/true_cstree_params=/" + pattern_cstree_params +
                   "/data=/" + pattern_cstree_data +
                   "/alg=/" + pattern_grasp +
                   "/structure.csv"), #
        cvars=("estimate" +
                "/true_cstree=/" + pattern_cstree +
                "/true_cstree_params=/" + pattern_cstree_params +
                "/data=/" + pattern_cstree_data +
                "/alg=/" + pattern_grasp +
                "/poss_cvars.json")
    script:
        "snake_scripts/estimate_grasp.py"

rule pc:               # tested
    # Use PC to learn CPDAG from which poss_cvars and a Markov equiv DAG are selected
    input:
        rules.cstree_data.output
    output:
        dag=("estimate" +
                "/true_cstree=/" + pattern_cstree +
                "/true_cstree_params=/" + pattern_cstree_params +
                "/data=/" + pattern_cstree_data +
                "/alg=/" + pattern_pc +
                "/structure.csv"),
        cvars=("estimate" +
                  "/true_cstree=/" + pattern_cstree +
                  "/true_cstree_params=/" + pattern_cstree_params +
                  "/data=/" + pattern_cstree_data +
                  "/alg=/" + pattern_pc +
                  "/poss_cvars.json")
    script:
        "snake_scripts/estimate_pc.py"

# The parameters fro the dag algorithms should be learned in separate rule,
# as this is done in R for both grasp and pc.
rule dag_bdeu_parameter_estimation:
    input:
        dag = ("estimate" +
                "/true_cstree=/{true_cstree}" +
                "/true_cstree_params=/{true_cstree_params}"
                "/data=/{data}" +
                "/alg=/{alg}" +
                "/structure.csv")
    output:
        dag_param_est=("dag_param_est" +
                       "/true_cstree=/{true_cstree}" +
                       "/true_cstree_params=/{true_cstree_params}" +
                       "/data=/{data}" +
                       "/alg=/{alg}" +
                       "/param_est=/"+pattern_dag_param_est +
                       "/params.csv")

# CS-BDeu
rule cstree_bdeu_parameter_estimation:
    input:
        cstree = rules.cslearn.output,
        data = rules.cstree_data.output
    output:
        param_est=("cstree_param_est" +
                    "/true_cstree=/" + pattern_cstree +
                    "/true_cstree_params=/" + pattern_cstree_params +
                    "/data=/" + pattern_cstree_data +
                    "/alg=/" + pattern_cslearn +
                    "/param_est=/"+pattern_cstree_param_est+
                    "/cstree.csv")
    script:
        "scripts/cstree_bdeu_parameter_estimation.R"

rule stagedtree_ml_parameter_estimation:
    input:
        ("estimate" +
        "/true_cstree=/" + pattern_cstree +
        "/true_cstree_params=/" + pattern_cstree_params +
