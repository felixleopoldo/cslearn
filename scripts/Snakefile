

rule all:
    input:
        "results/kl_divergence.png"

rule generate_cstree:           # tested
    # Calculate KL divergence between two distribution
    output:
        "cstrees/p={p}/max_cvar={max_cvar}/prob_cvar={prob_cvar}/seed={seed}/cstree.csv"
    script:
        "snake_scripts/generate_cstree.py"

rule simulate_data:             # tested
    # Simulate data from a distribution
    input:
        rules.generate_cstree.output
    output:
        "data/n={n}/seed={seed}/" + rules.generate_cstree.output[0] + "/data.csv"
    script:
        "snake_scripts/simulate_data.py"

rule estimate_cstree:           # untested
    # Estimate a distribution from data
    input:
        data=rules.simulate_data.output,
        poss_cvars="some dag" if not "{input_dag}" is None else []
    output:
        cstree="cslearn_cstree/p={p}/input_dag={input_dag}/max_cvar={max_cvar}/prob_cvar={prob_cvar}/seed={seed}/" + rules.simulate_data.output[0] + "/cstree.csv"
    script:
        "snake_scripts/estimate_cstree.py"

rule estimate_grasp:            # tested
    # Use GRaSP to learn CPDAG from which poss_cvars and a Markov equiv DAG are selected
    input:
        rules.simulate_data.output
    output:
        grasp_dag="sim_results/distr/est/p={p}_n={n}_seed={seed}/"
        "grasp/p={p}/max_cvar={max_cvar}/prob_cvar={prob_cvar}/seed={seed}/dag.csv",
        grasp_cvars="sim_results/distr/est/p={p}_n={n}_seed={seed}/"
        "grasp/p={p}/max_cvar={max_cvar}/prob_cvar={prob_cvar}/seed={seed}/poss_cvars.json"
    script:
        "snake_scripts/estimate_grasp.py"

rule estimate_pc:               # tested
    # Use PC to learn CPDAG from which poss_cvars and a Markov equiv DAG are selected
    input:
        rules.simulate_data.output
    output:
        pc_dag="sim_results/distr/est/p={p}_n={n}_seed={seed}/"
           "pc/p={p}/max_cvar={max_cvar}/prob_cvar={prob_cvar}/seed={seed}/dag.csv",
        pc_cvars="sim_results/distr/est/p={p}_n={n}_seed={seed}/"
           "pc/p={p}/max_cvar={max_cvar}/prob_cvar={prob_cvar}/seed={seed}/poss_cvars.json"
    script:
        "snake_scripts/estimate_pc.py"

rule joint_dag_distribution:    # untested
    # Estimate a distribution from data
    input:
        input_dag = rules.estimate_grasp.output['grasp_dag'] # optionally get dag from estimate_pc somehow
        data = rules.simulate_data.output
    output:
        joint_dag="sim_results/distr/est/p={p}_n={n}_seed={seed}/"
                  "joint_dag/p={p}/max_cvar={max_cvar}/prob_cvar={prob_cvar}/seed={seed}/.csv"
    script:
        "snake_scripts/joint_dag.py"

rule joint_cstree_distrubtion:  # untested
    # Estimate a distribution from data
    input:
        cstree = rules.estimate_cstree.output
        data = rules.simulate_data.output
    output:
        joint_cstree="sim_results/distr/est/p={p}_n={n}_seed={seed}/"
                     "joint_cstree/p={p}/max_cvar={max_cvar}/prob_cvar={prob_cvar}/seed={seed}/.csv"
    script:
        "snake_scripts/joint_cstree.py"


rule kl_plots:                  # not implemented
    input: "data/kl_divergence.csv"
